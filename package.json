{
  "name": "@operatiemobilisatie/ui",
  "version": "2.0.9",
  "description": "A collection of React components for OM websites and applications.",
  "author": "@douwepausma",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir .storybook/static",
    "typecheck": "tsc --noEmit",
    "vr": "npm run build-storybook && playwright test",
    "vr:update": "npm run build-storybook && playwright test --update-snapshots",
    "vr:docker": "docker run --rm --ipc=host -v \"$PWD\":/w -w /w -e HOME=/w/.dockerhome -u $(id -u):$(id -g) mcr.microsoft.com/playwright:v1.62.1-noble npm run vr",
    "vr:docker:update": "docker run --rm --ipc=host -v \"$PWD\":/w -w /w -e HOME=/w/.dockerhome -u $(id -u):$(id -g) mcr.microsoft.com/playwright:v1.62.1-noble npm run vr:update"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19",
    "http-server": "^14.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/css/style.css",
    "./fonts": "./dist/fonts/index.css",
    "./fonts.css": "./dist/fonts/index.css",
    "./fonts/*": "./dist/fonts/*",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/operatiemobilisatie"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/operatiemobilisatie/ui.git"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  }
}
