{
  "name": "@operatiemobilisatie/ui",
  "version": "2.0.9",
  "description": "A collection of React components for OM websites and applications.",
  "author": "@douwepausma",
  "license": "MIT",
  "scripts": {
    "rollup": "npx rollup -c",
    "rollup-watch": "npx rollup -cw",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir .storybook/static",
    "typecheck": "tsc --noEmit",
    "vr": "npm run build-storybook && playwright test",
    "vr:update": "npm run build-storybook && playwright test --update-snapshots",
    "vr:docker": "docker run --rm --ipc=host -v \"$PWD\":/w -w /w -e HOME=/w/.dockerhome -u $(id -u):$(id -g) mcr.microsoft.com/playwright:v1.62.1-noble npm run vr",
    "vr:docker:update": "docker run --rm --ipc=host -v \"$PWD\":/w -w /w -e HOME=/w/.dockerhome -u $(id -u):$(id -g) mcr.microsoft.com/playwright:v1.62.1-noble npm run vr:update"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19",
    "http-server": "^14.1.1",
    "postcss": "^8.4.47",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/typography": "^0.5.10",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "motion": "^12.4.10",
    "react-countup": "^6.5.3",
    "react-select": "^5.10.2",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "next": "^14 || ^15 || ^16",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": "./dist/lib/*.js",
    "./css": "./dist/css/style.css"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/operatiemobilisatie"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/operatiemobilisatie/ui.git"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
